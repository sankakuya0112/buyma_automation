# BUYMA認証情報
BUYMA_EMAIL=your_email@example.com
BUYMA_PASSWORD=your_password

# 為替レート
# 既定は ECB 参照レート (scripts/update_fx_rates.py / run_autopilot が data/fx_rates.json に保存) × 安全幅。
# 下の *_TO_JPY を設定すると ECB より優先される (固定したい時だけ。古い値の入れっぱなしに注意)。
#EUR_TO_JPY=178.15
#USD_TO_JPY=158.09
#GBP_TO_JPY=209.88
# 為替の安全幅 (0.03 = 3%。カード会社レートとの差と値動きの分)
#FX_BUFFER_PCT=0.03
# ECB キャッシュがこの日数より古いと警告
#FX_MAX_AGE_DAYS=7

# BUYMA の手数料
# 売上の振込手数料 (2026-10 時点 385 円、楽天銀行は 220 円)
#BUYMA_TRANSFER_FEE_JPY=385
# 成約ごとの固定手数料 (55〜220 円、2026-10-01〜) を原価に入れる (0 で無効)
#BUYMA_FIXED_FEE_ENABLED=1

# BUYMA のブラウザ自動操作 (旧 buyma_auto_listing.py の下書き作成・相場取得など)
# BUYMA の規約は許可のない外部プログラムを禁止しているため既定で停止。1 の時だけ動く (非推奨)。
# 本公開・出品停止・価格更新の自動操作はこの設定でも動かない。
#BUYMA_ALLOW_BROWSER_AUTOMATION=

# DeepL 翻訳 API (商品説明の英→日翻訳に使用)
# Free プラン: https://www.deepl.com/pro-api でキー取得。末尾 ":fx" が Free プラン判定
# 未設定の場合は FASHION_TERMS 辞書によるヒューリスティック置換にフォールバック
DEEPL_API_KEY=

# ---------------------------------------------------------------------------
# Claude API (AI 補強: 出品文 / カテゴリ / 審査 / 週次レビュー / 障害診断)
# 未設定なら AI は使わず従来の辞書翻訳・キーワード分類で動きます。
# キーは https://console.anthropic.com/ で発行し、この Mac の .env にだけ書く (チャットに貼らない)
ANTHROPIC_API_KEY=
# 週間予算 (円)。直近 7 日の合計がこれを超えると AI を自動停止
AI_WEEKLY_BUDGET_JPY=500
# 階層ごとのモデル (省略時は下記既定)。docs/AI_MODEL_POLICY.md 参照
#AI_MODEL_CHEAP=claude-haiku-4-5
#AI_MODEL_STANDARD=claude-sonnet-5
#AI_MODEL_PREMIUM=claude-fable-5-1
# タスク単位で階層を変える例 (審査も Haiku にして節約)
#AI_TASK_JUDGE_TIER=cheap
# 一時的に AI を全停止
#AI_DISABLED=1
