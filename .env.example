# BUYMA認証情報
BUYMA_EMAIL=your_email@example.com
BUYMA_PASSWORD=your_password

# Selenium設定
SELENIUM_HEADLESS=true
SELENIUM_TIMEOUT=30

# 出品設定
MIN_PROFIT_RATE=0.20
LISTING_INTERVAL_MIN=5
LISTING_INTERVAL_MAX=15

# 為替レート (pricing.py の DEFAULT_EXCHANGE_RATES を上書き)
# 月次で ECB 参考レート等に更新する運用。
# 2026-04-23 ECB 参考値: EUR=186, USD=160, GBP=210
EUR_TO_JPY=186.0
USD_TO_JPY=160.0
GBP_TO_JPY=210.0

# 送料（EUR）
SHIPPING_COST_EUR=30.0

# DeepL 翻訳 API (商品説明の英→日翻訳に使用)
# Free プラン: https://www.deepl.com/pro-api でキー取得。末尾 ":fx" が Free プラン判定
# 未設定の場合は FASHION_TERMS 辞書によるヒューリスティック置換にフォールバック
DEEPL_API_KEY=
